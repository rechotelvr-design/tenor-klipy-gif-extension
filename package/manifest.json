{
  "manifest_version": 3,
  "name": "Tenor + Klipy GIF Browser",
  "version": "1.1.0",
  "description": "Search, preview, and copy animated GIFs from Tenor and Klipy in one popup interface. Injects a GIF picker button into YouTube comment/reply boxes.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "GIF Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.svg",
      "32": "assets/icons/icon-32.svg",
      "48": "assets/icons/icon-48.svg",
      "128": "assets/icons/icon-128.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icons/icon-16.svg",
    "32": "assets/icons/icon-32.svg",
    "48": "assets/icons/icon-48.svg",
    "128": "assets/icons/icon-128.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_scripts/youtube-inject.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "gif-picker.html",
        "gif-picker.css",
        "gif-picker.js",
        "assets/icons/*",
        "assets/sample_gifs.json",
        "src/providers/*",
        "src/utils/*"
      ],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
